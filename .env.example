# ---------------------------------------------------------------------------
# VOX Digital Agency — environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Resend email provider (https://resend.com) — required for contact, booking
# and newsletter forms to send mail. Without a key the API routes respond
# gracefully with a 503 "email provider not configured" error.
RESEND_API_KEY=

# The "from" address used for outgoing form emails. Must be a verified
# domain/identity on your Resend account (e.g. hello@yourdomain.com).
EMAIL_FROM=

# The inbox that receives contact/booking form submissions.
# Defaults to info@voxdigitalagency.com when left blank.
CONTACT_TO=

# Optional — public site URL used in sitemap / canonical / OG metadata.
# Leave blank to auto-derive from VERCEL_URL or NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL=

# Optional — deploy environment label ("development" | "production").
NODE_ENV=development
